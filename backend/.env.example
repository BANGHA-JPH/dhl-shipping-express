# Port for Express API Server
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dhl_portal?retryWrites=true&w=majority

# Admin Login Credentials
ADMIN_EMAIL=admin@dhl.com
ADMIN_PASSWORD=admin123

# Domain & Email Configuration
PORTAL_DOMAIN=dhlglobaltracking.com
FROM_EMAIL=DHL Express Support <support@dhlglobaltracking.com>

# Resend API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
